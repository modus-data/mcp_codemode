# OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Pipedream API Key
# Get your API key from: https://pipedream.com/settings/account
PIPEDREAM_API_KEY=your-pipedream-api-key-here

# E2B API Key (required for E2BRunEnvironment)
# Get your API key from: https://e2b.dev/docs/getting-started/api-key
E2B_API_KEY=your-e2b-api-key-here
